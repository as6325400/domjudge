{% extends "team/base.html.twig" %}

{% block title %}Start Virtual Contest - {{ parent() }}{% endblock %}

{% block content %}

    <div class="container pt-5">
        <h1 class="text-center">Start Virtual Participation</h1>

        <div class="card mx-auto mt-4" style="max-width: 600px;">
            <div class="card-body">
                <h5 class="card-title">{{ contest.name }}</h5>
                <ul class="list-unstyled mb-3">
                    <li><strong>Duration:</strong> {{ duration }}</li>
                    <li><strong>Problems:</strong> {{ numProblems }}</li>
                </ul>

                <div class="alert alert-warning">
                    <strong>Warning:</strong> Once started, the virtual contest cannot be paused.
                    The timer will start immediately.
                </div>

                <form method="POST" action="{{ path('team_virtual_start', {contestId: contest.cid}) }}">
                    <button type="submit" class="btn btn-primary btn-lg w-100">
                        Start Virtual Contest
                    </button>
                </form>
            </div>
        </div>
    </div>

{% endblock %}
